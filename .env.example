# =============================================================
#  RECALL — environment variables
#
#  Copy this file to `.env.local` and fill in the real values.
#  `.env.local` is gitignored. NEVER commit real keys, never
#  paste them into a chat, never put them in a screenshot.
#  If a secret is ever exposed, rotate it immediately.
# =============================================================

# --- Safe to expose to the browser (they are public by design) ---
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- SERVER ONLY. Bypasses every RLS policy. Treat as root password. ---
# Used only by the background sync worker. Never import this into a
# client component or anything under app/ that runs in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# --- OpenRouter (server only) — reads timetable images/PDFs ---
# We use OpenRouter rather than Google directly because the Gemini developer
# API is blocked in some regions. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Optional: override the model without changing code.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=a-long-random-string

# --- Who may sign in ---
# Comma-separated. Defaults to student.uol.edu.pk when unset.
# Add uol.edu.pk to let staff in, or another university's domain later.
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=student.uol.edu.pk
