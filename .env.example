# =============================================================
#  RECALL — environment variables
#
#  Copy this file to `.env.local` and fill in the real values.
#  `.env.local` is gitignored. NEVER commit real keys, never
#  paste them into a chat, never put them in a screenshot.
#  If a secret is ever exposed, rotate it immediately.
# =============================================================

# --- Safe to expose to the browser (they are public by design) ---
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- SERVER ONLY. Bypasses every RLS policy. Treat as root password. ---
# Used only by the background sync worker. Never import this into a
# client component or anything under app/ that runs in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# --- AI providers (server only) — timetable reading, planner, Ask Recall ---
# Every one is a free tier and every one is optional; Recall uses whichever
# keys are present and tries them in a staggered race. Each provider has its
# own daily quota, so more keys = more students served per day.
#
# OpenRouter's free tier is only 50 requests/day for the WHOLE account (1000
# once $10 of credit has ever been bought), so on its own it serves about a
# dozen students a day. Add at least one of the others.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
#   https://console.groq.com/keys           (text + vision, thousands/day)
# GROQ_API_KEY=
#   https://aistudio.google.com/apikey      (text + vision)
# GEMINI_API_KEY=
#   https://cloud.cerebras.ai               (text only, very fast)
# CEREBRAS_API_KEY=
#   https://console.mistral.ai/api-keys     (text + vision)
# MISTRAL_API_KEY=

# Optional: override any provider's model list without a deploy, comma-
# separated. Text: OPENROUTER_TEXT_MODELS, GROQ_TEXT_MODELS, GEMINI_TEXT_MODELS,
# CEREBRAS_TEXT_MODELS, MISTRAL_TEXT_MODELS. Vision: OPENROUTER_MODELS,
# GROQ_VISION_MODELS, GEMINI_VISION_MODELS, MISTRAL_VISION_MODELS.
# scripts/check-vision.mjs and scripts/check-text-models.mjs show what is
# answering today.

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=a-long-random-string

# --- Who may sign in ---
# Comma-separated. Defaults to student.uol.edu.pk when unset.
# Add uol.edu.pk to let staff in, or another university's domain later.
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=student.uol.edu.pk
